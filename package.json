{
    "title": "Guillaume Sainthillier",
    "name": "sainthillier",
    "version": "1.2.0",
    "private": true,
    "description": "https://sainthillier.fr",
    "homepage": "https://sainthillier.fr",
    "license": "MIT",
    "type": "module",
    "author": "Guillaume Sainthillier",
    "contributors": [
        "David Miller (http://davidmiller.io/)"
    ],
    "scripts": {
        "dev": "vite build --mode development && yarn skills-cloud",
        "watch": "vite build --watch --mode development",
        "build": "vite build && yarn skills-cloud",
        "build:hugo": "yarn build && yarn hugo",
        "build:hugo:preview": "yarn build && yarn hugo -D -F",
        "hugo": "hugo --gc --minify",
        "skills-cloud": "node scripts/skills-cloud.js",
        "hugo:dev": "hugo server -D",
        "prepare": "husky install",
        "lint": "biome check --write assets",
        "lint-ci": "biome check assets",
        "prettier": "prettier --write \"**/*.{css,md,yml,yaml}\"",
        "prettier:check": "prettier --check \"**/*.{css,md,yml,yaml}\"",
        "format": "yarn lint && yarn prettier",
        "knip": "knip",
        "knip:fix": "knip --fix",
        "size:json": "node scripts/bundle-size.js"
    },
    "dependencies": {
        "@webcomponents/custom-elements": "^1.6.0",
        "lite-youtube-embed": "^0.3.4",
        "lucide": "^1.52.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@fontsource/arimo": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.19.1",
        "hugo-extended": "^0.166.0",
        "husky": "9.1.7",
        "knip": "^6.40.0",
        "lint-staged": ">=17.6.0",
        "opentype.js": "^2.0.0",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svgo": "^4",
        "tailwindcss": "^4.3.3",
        "terser": "^5.51.2",
        "typescript": "^7.0.2",
        "vite": "^8",
        "yaml": "^2.9.1"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,json}": "biome check --write --no-errors-on-unmatched",
        "*.{css,md,yaml,yml}": "prettier --write"
    }
}
