{
    "title": "Guillaume Sainthillier",
    "name": "sainthillier",
    "version": "1.2.0",
    "private": true,
    "description": "https://sainthillier.fr",
    "homepage": "https://sainthillier.fr",
    "license": "MIT",
    "type": "module",
    "author": "Guillaume Sainthillier",
    "contributors": [
        "David Miller (http://davidmiller.io/)"
    ],
    "scripts": {
        "dev": "hugo server -D",
        "build": "hugo --gc --minify",
        "build:preview": "hugo --gc --minify -D -F",
        "fonts:subset": "node scripts/subset-fonts.js",
        "og-image": "node scripts/og-image.js",
        "cgv-pdf": "node scripts/cgv-pdf.js",
        "prepare": "husky install",
        "lint": "biome check --write assets",
        "lint-ci": "biome check assets",
        "prettier": "prettier --write \"**/*.{css,md,yml,yaml}\"",
        "prettier:check": "prettier --check \"**/*.{css,md,yml,yaml}\"",
        "format": "pnpm lint && pnpm prettier",
        "knip": "knip",
        "knip:fix": "knip --fix",
        "size:json": "node scripts/bundle-size.js"
    },
    "dependencies": {},
    "devDependencies": {
        "@biomejs/biome": "2.6.9",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@tailwindcss/cli": "^4.3.5",
        "@types/node": "^26.6.6",
        "hugo-extended": "^0.170.0",
        "husky": "9.1.7",
        "knip": "^6.47.0",
        "lint-staged": ">=17.6.0",
        "lucide-static": "^1.77.0",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "subset-font": "^2.9.0",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,json}": "biome check --write --no-errors-on-unmatched",
        "*.{css,md,yaml,yml}": "prettier --write"
    },
    "packageManager": "pnpm@12.23.0"
}
